  "narrative": {
    "northStar": "Start Line",
    "overview": "Start Line pairs the energy of running photography with clear Thai typography and direct actions. Ink navigation frames the photographic home entrance; lime marks the next useful action. Registration, lookup, and reading surfaces use white and pale green materials so task content remains clear on a phone.\n\nThis is the implemented replacement world approved for Run Event. Its visual language is modern sports, mobile-first, with prominent event imagery and controlled bright color. The generic runner photograph is explicitly illustrative; event images and factual content come from the API.",
    "keyCharacteristics": [
      "Athletic photography and ink framing.",
      "Thai-first typography and generous touch targets.",
      "Lime actions, quiet light task surfaces.",
      "Border-led cards and explicit semantic states."
    ],
    "rules": [
      {
        "body": "Use lime for the main next action and the established active-step treatment; preserve semantic error and warning colors.",
        "name": "The Action Rule",
        "section": "colors"
      },
      {
        "body": "Preserve Thai-capable fonts, readable body text, and the established relaxed line heights.",
        "name": "The Thai Reading Rule",
        "section": "typography"
      },
      {
        "body": "Keep ordinary content cards flat; reserve retained elevation for overlays and selected controls.",
        "name": "The Flat Surface Rule",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep lime actions readable with dark ink text.",
      "Do use Thai-capable fonts and retain generous mobile touch targets.",
      "Do preserve real loading, empty, error, saved, and registration states.",
      "Do check stylesheet specificity before documenting or changing field states."
    ],
    "donts": [
      "Don't restore the old blue identity from the legacy variable names.",
      "Don't add shadows to ordinary event cards or task panels.",
      "Don't invent event photography, reviews, counts, payment accounts, or QR instructions.",
      "Don't convert registration completion into a claim that payment was approved."
    ]
  }
}
