API_PROXY_TARGET=http://localhost:4000
# Estimated shipping amount before checkout; keep aligned with API SHIPPING_FEE.
NEXT_PUBLIC_SHIPPING_FEE=50


# --- Docker / CI (ไม่ต้องใส่ในไฟล์นี้ถ้าไม่ได้รัน compose) ---
# ใน Docker API_PROXY_TARGET เป็น build arg (ฝังตอน build ไม่ใช่ตอนรัน): docker compose อ่านจาก environment
# CI ใช้ GitHub variable API_PROXY_TARGET (production: https://api.walkruntogive2027.com) ถ้าเปลี่ยนต้อง build image ใหม่
# API_PROXY_TARGET=http://host.docker.internal:4000
# port บน host ที่ container platform bind (127.0.0.1 เท่านั้น) ใช้กับ docker-compose*.yml
# (local compose ค่าเริ่มต้น 3100, production ค่าเริ่มต้น 3001)
# PLATFORM_HOST_PORT=3001